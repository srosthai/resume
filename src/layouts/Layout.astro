---
import '@fontsource-variable/archivo/wght.css';
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NoiseOverlay from '../components/NoiseOverlay.astro';
import { profile } from '../data/resume';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image = '/og-image.jpg' } = Astro.props;
const site = Astro.site ?? new URL('https://resume.srosthai.me');
const siteUrl = new URL('/', site).toString();
const canonical = new URL(Astro.url.pathname, site).toString();
const ogImage = new URL(image, site).toString();
const portrait = new URL('/portrait.webp', site).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${site.origin}/#person`,
      name: profile.name,
      alternateName: ['Sros Thai', 'srosthai'],
      jobTitle: profile.role,
      description: profile.summary,
      url: siteUrl,
      image: portrait,
      email: `mailto:${profile.email}`,
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Siem Reap',
        addressCountry: 'KH'
      },
      worksFor: {
        '@type': 'Organization',
        name: 'eOcambo Technology'
      },
      alumniOf: {
        '@type': 'CollegeOrUniversity',
        name: 'Build Bright University'
      },
      sameAs: [profile.github, profile.linkedin, profile.projectsUrl],
      knowsLanguage: ['Khmer', 'English'],
      knowsAbout: [
        'Laravel',
        'PHP',
        'MySQL',
        'REST APIs',
        'GraphQL',
        'Vue.js',
        'Nuxt',
        'Vant UI',
        'React',
        'Next.js',
        'Astro',
        'Nitro',
        'Tailwind CSS',
        'TypeScript',
        'Linux',
        'SSH',
        'cPanel',
        'DigitalOcean',
        'Netlify',
        'Vercel',
        'Codex',
        'Claude',
        'OpenCode',
        'Antigravity'
      ]
    },
    {
      '@type': 'WebSite',
      '@id': `${site.origin}/#website`,
      url: siteUrl,
      name: 'Sros Thai — Resume',
      alternateName: ['Sros Thai', 'resume.srosthai.me'],
      description,
      inLanguage: 'en',
      publisher: { '@id': `${site.origin}/#person` }
    },
    {
      '@type': 'ProfilePage',
      '@id': `${site.origin}/#profile`,
      url: siteUrl,
      name: title,
      description,
      isPartOf: { '@id': `${site.origin}/#website` },
      about: { '@id': `${site.origin}/#person` },
      mainEntity: { '@id': `${site.origin}/#person` },
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: ogImage,
        width: 1200,
        height: 630
      }
    }
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          const theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          document.documentElement.dataset.theme = theme;
        } catch {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Sros Thai" />
    <meta name="application-name" content="Sros Thai — Resume" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#f3f2ed" />
    <meta name="color-scheme" content="light dark" />

    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" as="image" href="/portrait.webp" type="image/webp" fetchpriority="high" />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Sros Thai" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Sros Thai, full stack developer, in a navy suit." />
    <meta property="profile:first_name" content="Sros" />
    <meta property="profile:last_name" content="Thai" />
    <meta property="profile:username" content="srosthai" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Sros Thai, full stack developer, in a navy suit." />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <NoiseOverlay />

    <script is:inline>
      (() => {
        const button = document.querySelector('[data-theme-toggle]');
        if (!button) return;

        const root = document.documentElement;
        const meta = document.querySelector('meta[name="theme-color"]');

        const sync = () => {
          const isDark = root.dataset.theme === 'dark';
          button.setAttribute('aria-label', `Switch to ${isDark ? 'light' : 'dark'} mode`);
          button.setAttribute('aria-pressed', String(isDark));
          meta?.setAttribute('content', isDark ? '#0e1518' : '#f3f2ed');
        };

        const apply = (theme) => {
          root.dataset.theme = theme;
          try {
            localStorage.setItem('theme', theme);
          } catch {
            /* ignore */
          }
          sync();
        };

        button.addEventListener('click', () => {
          const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
          const rect = button.getBoundingClientRect();
          root.style.setProperty('--theme-x', `${rect.left + rect.width / 2}px`);
          root.style.setProperty('--theme-y', `${rect.top + rect.height / 2}px`);

          const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (document.startViewTransition && !reduce) {
            document.startViewTransition(() => apply(next));
          } else {
            root.classList.add('theme-transition');
            apply(next);
            window.setTimeout(() => root.classList.remove('theme-transition'), 420);
          }
        });

        sync();
      })();
    </script>
  </body>
</html>
