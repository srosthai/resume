---
import { profile } from '../data/resume';
import NavBar from './NavBar.jsx';
---

<header class="site-header">
  <div class="site-header__inner shell">
    <a class="brand" href="#top" aria-label="Sros Thai, back to top">
      <img class="brand__mark" src="/brand-mark.webp" alt="" width="34" height="34" />
      <span class="brand__text">
        Sros Thai
        <span>Full Stack Developer</span>
      </span>
    </a>

    <div class="gooey-wrap">
      <NavBar client:media="(min-width: 901px)" />
    </div>

    <nav class="site-nav" aria-label="Sections">
      <a href="#work">Work</a>
      <a href="#projects">Projects</a>
      <a href="#skills">Skills</a>
      <a href="#contact">Contact</a>
    </nav>

    <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark mode">
      <svg class="theme-toggle__sun" viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
        <circle cx="12" cy="12" r="4.1" stroke="currentColor" stroke-width="1.6"></circle>
        <path d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
      </svg>
      <svg class="theme-toggle__moon" viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
        <path d="M20.1 14.2A8.2 8.2 0 0 1 9.8 3.9a7.1 7.1 0 1 0 10.3 10.3Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
      </svg>
    </button>

    <a class="header-email" href={`mailto:${profile.email}`}>Email</a>
  </div>
</header>
