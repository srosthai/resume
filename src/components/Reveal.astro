---
import AnimatedContent from './reactbits/AnimatedContent.jsx';

const { distance = 24, duration = 0.7, delay = 0 } = Astro.props;
---

<AnimatedContent
  client:idle
  distance={distance}
  direction="vertical"
  duration={duration}
  ease="power3.out"
  initialOpacity={0}
  animateOpacity
  threshold={0.08}
  once
  delay={delay}
  className="reveal"
  style={{}}
>
  <slot />
</AnimatedContent>
